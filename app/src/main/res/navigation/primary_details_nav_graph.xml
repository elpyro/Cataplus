<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/registrofacturacion_list_fragment">

    <fragment
        android:id="@+id/registrofacturacion_list_fragment"
        android:name="com.example.facturacionycatalogospdf.RegistrofacturacionListFragment"
        android:label="RegistrofacturacionListFragment" >
        <action
            android:id="@+id/show_registrofacturacion_detail"
            app:destination="@id/registrofacturacion_detail_fragment" />
    </fragment>
    <fragment
        android:id="@+id/registrofacturacion_detail_fragment"
        android:name="com.example.facturacionycatalogospdf.RegistrofacturacionDetailFragment"
        android:label="registrofacturacion_detail"
        tools:layout="@layout/fragment_registrofacturacion_detail">
        <argument
            android:name="item_id"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
</navigation>