<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.cataplus.facturacionycatalogospdf.Vista_pdf">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton_facturar"

        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="60dp"
        android:layout_marginRight="300dp"
        android:layout_marginBottom="17dp"
        app:srcCompat="@drawable/ic_baseline_share_24" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_enviar_numero"

        android:layout_width="160dp"
        android:layout_height="180dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="180dp"
        android:layout_marginRight="300dp"
        android:layout_marginBottom="17dp"
        app:srcCompat="@drawable/whatapp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_regresar"

        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="300dp"

        android:layout_marginBottom="17dp"
        app:srcCompat="@drawable/ic_baseline_keyboard_return_24" />

    <com.github.barteksc.pdfviewer.PDFView
        android:id="@+id/vista_pdf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"></com.github.barteksc.pdfviewer.PDFView>
</RelativeLayout>