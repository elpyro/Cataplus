<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"

    android:padding="10dp"
    tools:context="com.cataplus.facturacionycatalogospdf.Fragmento_consultar_clientes">

    <EditText
        android:id="@+id/editTextText_buscar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="0dp"
        android:autofillHints="nombre_cliente"
        android:ems="10"
        android:hint="@string/Buscar"
        android:inputType="textCapSentences|textAutoCorrect|textPersonName"
        android:textColor="@color/black"
        android:textColorHint="@color/secondary_text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_facturar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/editTextText_buscar"
        android:layout_marginTop="15dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_agregar_cliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="31dp"
        android:layout_marginBottom="48dp"
        android:clickable="true"
        app:srcCompat="@android:drawable/ic_input_add" />
</RelativeLayout>