<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"

    tools:context="com.cataplus.facturacionycatalogospdf.Fragmento_incluir_producto">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton_guardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="31dp"
        android:layout_marginBottom="48dp"
        android:clickable="true"
        android:onClick="guardar"
        app:srcCompat="@android:drawable/ic_menu_save" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton_eliminar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="48dp"

        android:clickable="true"
        android:onClick="eliminar"
        android:visibility="gone"
        app:srcCompat="@android:drawable/ic_menu_delete" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_marginTop="-2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colordegadrado1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_logo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:gravity="center"
                    android:text="@string/Fotos"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView_incluir_foto1"
                    android:layout_width="200dp"
                    android:layout_height="200dp"

                    android:layout_margin="5dp"
                    android:layout_weight="0.2"
                    app:srcCompat="@drawable/agregar_foto"
                    tools:srcCompat="@drawable/agregar_foto" />

                <ImageView
                    android:id="@+id/imageView_incluir_foto2"
                    android:layout_width="150dp"
                    android:layout_height="150dp"

                    android:layout_margin="5dp"
                    android:layout_weight="0.2"
                    android:visibility="gone"
                    app:srcCompat="@drawable/agregar_foto"
                    tools:srcCompat="@drawable/agregar_foto" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout_id"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/id_consecutivo_producto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:textColor="@color/black"
                    android:text=""
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editText_incluir_nombre_empresa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:autofillHints="nombre_producto"
                    android:ems="10"
                    android:hint="@string/nombre"
                    android:inputType="textCapSentences|textAutoCorrect|textPersonName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editText_codigo_barras"
                    tools:ignore="Autofill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:ems="10"
                    android:hint="@string/codigo"
                    android:inputType="textPersonName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/button3"
                    android:layout_width="178dp"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:gravity="center|center_horizontal"
                    app:icon="@drawable/ic_baseline_qr_code_scanner_24"
                    app:iconGravity="textStart" />

            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colordegadrado1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_precios"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:gravity="center"
                    android:text="@string/Precios"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                tools:ignore="Autofill">

                <EditText
                    android:id="@+id/editText_costo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="0.2"
                    android:ems="10"
                    android:gravity="center"
                    android:hint="@string/Costo"

                    android:inputType="number|numberDecimal"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editText_mayor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="0.2"
                    android:ems="10"
                    android:gravity="center"
                    android:hint="@string/Mayor"
                    android:inputType="number|numberDecimal"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editText_detal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="0.2"
                    android:ems="10"
                    android:gravity="center"
                    android:hint="@string/Detal"
                    android:inputType="number|numberDecimal"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"

                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Switch
                    android:id="@+id/switch_visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Visible"
                    android:textColor="@color/black"
                    android:textOn="Activo"
                    android:textSize="14sp"
                    tools:checked="true" />

                <Switch
                    android:id="@+id/switch_cantidad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:checked="false"

                    android:text="@string/Rastreo_de_cantidad"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    tools:checked="false" />

                <EditText
                    android:id="@+id/editTextNumber_cantidad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:ems="10"
                    android:gravity="center"
                    android:hint="@string/Cantidad"
                    android:inputType="number"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:visibility="gone"
                    tools:ignore="Autofill" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textVie_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:text="@string/Categoria"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinner_categoria"
                    style="@android:style/Widget.DeviceDefault.Light.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:background="@color/purple_500"
                    android:entries="@array/categoria"
                    android:popupBackground="@color/purple_200"
                    />

            </LinearLayout>

            <LinearLayout
                tools:ignore="Autofill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_medida"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:text="@string/Medida"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinner_medida"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:background="@color/purple_500"
                    android:entries="@array/medidas"
                    android:popupBackground="@color/purple_200" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView_incluir_foto3"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_margin="5dp"
                    android:layout_weight="0.2"
                    android:visibility="gone"
                    app:srcCompat="@drawable/agregar_foto"
                    tools:srcCompat="@drawable/agregar_foto" />

                <ImageView
                    android:id="@+id/imageView_incluir_foto4"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_margin="5dp"
                    android:layout_weight="0.2"
                    android:visibility="gone"
                    app:srcCompat="@drawable/agregar_foto"
                    tools:srcCompat="@drawable/agregar_foto" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextText_incluir_marca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:autofillHints="descripcion"
                    android:ems="10"
                    android:hint="@string/Marca"
                    android:inputType="textCapSentences|textAutoCorrect|textPersonName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextText_proveedor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:autofillHints="proveedor"
                    android:ems="10"
                    android:hint="@string/proveedor"
                    android:inputType="textCapSentences|textAutoCorrect|textPersonName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="16sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editTextTextPersonName_incluir_color"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:autofillHints="colores"
                    android:ems="10"
                    android:hint="@string/Color"
                    android:inputType="textCapSentences|textAutoCorrect|textPersonName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/editTextTextPersonName_incluir_talla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="0.2"
                    android:autofillHints="tallas"
                    android:ems="10"
                    android:hint="@string/Talla"
                    android:inputType="textCapSentences|textAutoCorrect|textPersonName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout_ulitma_modificacion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textView_label_actualizacion1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0.2"
                    android:gravity="right"
                    android:text="@string/ultima_actulizacion"
                    android:textColor="@color/black"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textView_fecha1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="0.2"
                    android:textColor="@color/black"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textView_actulizacion_usuario1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_weight="0.2"
                    android:textColor="@color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayor_eliminar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="120dp"
                android:layout_marginRight="120dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/button5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Eliminar" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>